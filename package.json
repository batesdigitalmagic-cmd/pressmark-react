{
  "name": "pressmark-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:zoho": "node --env-file=.env scripts/verify-zoho.mjs",
    "verify:tree": "node scripts/verify-folder-tree.mjs",
    "diagnose:link": "node --env-file=.env scripts/diagnose-upload-link.mjs",
    "token": "node --env-file=.env scripts/refresh-token.mjs",
    "seed:license": "node --env-file=.env scripts/seed-test-license.mjs",
    "health": "node --env-file=.env -e \"import('./api/health.js').then(async m=>{const r=await m.default(new Request('https://local/api/health'));console.log(await r.text())})\"",
    "blog:generate": "node scripts/generate-blog-pages.mjs",
    "prebuild": "node scripts/generate-blog-pages.mjs",
    "predev": "node scripts/generate-blog-pages.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
