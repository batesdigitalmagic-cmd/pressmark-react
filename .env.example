# Pressmark Studio — Zoho integration
# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─────────────────────────────────────────────────────────────
# 1. REQUIRED AT RUNTIME — the quote form fails without these
# ─────────────────────────────────────────────────────────────

# Zoho API Console → your client → Client Secret tab.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Long-lived token that mints access tokens on every request.
# Produced once by /api/auth/zoho/callback. Does not expire.
ZOHO_REFRESH_TOKEN=

# WorkDrive folder that per-lead subfolders are created inside.
# Open the parent folder in WorkDrive; the id is the last path segment of the
# URL: https://workdrive.zoho.com/folder/<THIS_VALUE>
ZOHO_WORKDRIVE_PARENT_FOLDER_ID=


# ─────────────────────────────────────────────────────────────
# 2. ONE-TIME OAUTH SETUP — needed only to obtain the refresh
#    token above. Unset both once you have it.
# ─────────────────────────────────────────────────────────────

# Any long random string. Gates /api/auth/zoho/start so the public
# can't run the consent flow. Unset = route disabled (503).
#   openssl rand -hex 32
ZOHO_SETUP_SECRET=

# Must match the redirect URI registered in the Zoho API Console byte for byte.
ZOHO_REDIRECT_URI=https://pressmark.studio/api/auth/zoho/callback

# Permissions requested at consent. Defaults to this if unset.
# ZOHO_SCOPES=ZohoCRM.modules.leads.CREATE,WorkDrive.files.ALL,WorkDrive.links.ALL,ZohoMail.messages.CREATE,ZohoMail.accounts.READ


# ─────────────────────────────────────────────────────────────
# 2b. WELCOME EMAIL — sent from /api/quote via Zoho Mail
# ─────────────────────────────────────────────────────────────

# Must be an address the authenticated Zoho Mail account can send as.
ZOHO_MAIL_FROM_ADDRESS=quotes@pressmark.studio

# Name in the signature line.
# ZOHO_MAIL_SIGNATURE_NAME=Justin Bates

# Auto-discovered via ZohoMail.accounts.READ. Set only to pin a specific account.
# ZOHO_MAIL_ACCOUNT_ID=

# Non-.com data centers: https://mail.zoho.eu, .in, .com.au
# ZOHO_MAIL_DOMAIN=https://mail.zoho.com


# ─────────────────────────────────────────────────────────────
# 2c. BATCHCUTOUT STOREFRONT
#
# Everything here is SERVER ONLY except the two VITE_ values.
# Vite inlines any variable referenced from src/ into the browser
# bundle — the VITE_ prefix marks intent, but the real protection is
# that src/ never imports lib/ or api/ (enforced by eslint).
# ─────────────────────────────────────────────────────────────

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_TAX=false

# License storage. Vercel → Storage → Upstash Redis provisions KV_REST_API_*
# automatically. Required unless LICENSE_API_URL below is set.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Remote license server. Leave BOTH blank to mint and store keys in this app.
# Setting LICENSE_API_URL switches lib/licenses.js to proxy that server
# instead — no other code changes.
LICENSE_API_URL=
LICENSE_ADMIN_TOKEN=

# Downloads. Each URL must return the file itself, not a WorkDrive preview
# page. Versions live in the RELEASES map in lib/releases.js; keep old ones
# there and keep their variables set, so reinstalls and the download links in
# old purchase emails keep working.
#
# CURRENT_VERSION only overrides which release /api/download serves by default.
# Leave it BLANK to serve the latest (currently 1.1.0). Set it to an older
# version to roll back without a deploy — but a stale value left here will pin
# customers to that old release.
CURRENT_VERSION=
DOWNLOAD_URL_1_0_0=
DOWNLOAD_URL_1_1_0=

# Portal sign-in token signing. Any long random string:
#   openssl rand -hex 32
# Rotating it signs everyone out; it invalidates no licenses.
PORTAL_SESSION_SECRET=

# Public — safe in the browser
VITE_SITE_URL=https://pressmark.studio
VITE_DOWNLOAD_URL=https://pressmark.studio/api/download


# ─────────────────────────────────────────────────────────────
# 3. DATA CENTER — only if your Zoho account is not on .com
#    The callback page prints the correct values for your account.
# ─────────────────────────────────────────────────────────────

# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_WORKDRIVE_DOMAIN=https://workdrive.zoho.com


# ─────────────────────────────────────────────────────────────
# 4. OPTIONAL TUNING
# ─────────────────────────────────────────────────────────────

# How long a customer's upload link stays live. Defaults to 30.
# ZOHO_UPLOAD_LINK_EXPIRY_DAYS=30

# Custom CRM field API names. Leave unset until you create the fields —
# this data always lands in the lead's Description regardless.
# CRM → Setup → Modules → Leads → field → API name.
# ZOHO_CRM_FIELD_PUBLICATION_TYPE=
# ZOHO_CRM_FIELD_PAGE_COUNT=
# ZOHO_CRM_FIELD_DEADLINE=
# ZOHO_CRM_FIELD_BUDGET=
# ZOHO_CRM_FIELD_WORKDRIVE_LINK=
# ZOHO_CRM_FIELD_UPLOAD_LINK=


# ─────────────────────────────────────────────────────────────
# 5. ANALYTICS (Google Analytics 4)
#
# Public by design — a Measurement ID is not a secret. Leave blank
# to disable analytics entirely; nothing loads and no request is
# made to Google.
#
# /portal, /sandbox, /sandbox-portal and /health are never measured:
# gtag.js is not even requested on those paths.
# ─────────────────────────────────────────────────────────────

VITE_GA4_ID=

# analytics_storage is ALWAYS denied by default and granted only when a
# visitor accepts the consent banner. Advertising signals are never granted.
# The visitor's choice is remembered in localStorage.

# Privacy Policy URL shown in the consent banner. Leave blank until the page
# exists — no link renders rather than one pointing at a 404.
VITE_PRIVACY_URL=/privacy
